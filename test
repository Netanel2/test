        private void BtnBrowseOutput_Click(object sender, EventArgs e)
        {
            using (FolderBrowserDialog fbd = new FolderBrowserDialog())
            {
                fbd.Description = "בחר את התיקייה שבה יישמר קובץ התוצאות";
                if (fbd.ShowDialog() == DialogResult.OK)
                {
                    txtOutputFolderInput.Text = fbd.SelectedPath;
                }
            }
        }
        private void btnScan_Click(object sender, EventArgs e)
        {
            RefreshFiles();
        }

        private void RefreshFiles()
        {
            try
            {
                cmbFiles.Items.Clear();
                targetFolder = txtFolderInput.Text.Trim();

                if (Directory.Exists(targetFolder))
                {
                    string[] files = Directory.GetFiles(targetFolder, "*");
                    foreach (string file in files) cmbFiles.Items.Add(Path.GetFileName(file));
                    if (cmbFiles.Items.Count > 0) cmbFiles.SelectedIndex = 0;
                }
                else
                {
                    MessageBox.Show("נתיב תיקיית המקור שהזנת אינו קיים בדיסק!", "נתיב שגוי", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("שגיאה בסריקת התיקייה:\n" + ex.Message, "שגיאה", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            ValidateForm();
        }

        // אירוע הוספת מספר פלאפון לרשימת החיפוש
        private void BtnAdd_Click(object sender, EventArgs e)
        {
            string rawVal = txtSearchValue.Text.Trim();
            string cleanVal = Regex.Replace(rawVal, @"[^\d]", "");

            if (string.IsNullOrEmpty(cleanVal))
            {
                MessageBox.Show("אנא הזן מספר פלאפון תקין לחיפוש (המכיל ספרות).", "שדה ריק", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (searchValues.Contains(cleanVal))
            {
                MessageBox.Show("המספר הזה כבר קיים ברשימת החיפוש שלך.", "ערך כפול", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            searchValues.Add(cleanVal);
            lstRequests.Items.Add($"📞 מחפש פלאפון: {rawVal}");

            txtSearchValue.Text = "";
            txtSearchValue.Focus();
            ValidateForm();
        }

        // אירוע מחיקת מספר מסומן מהרשימה
        private void BtnRemove_Click(object sender, EventArgs e)
        {
            if (lstRequests.SelectedIndex != -1)
            {
                int index = lstRequests.SelectedIndex;
                searchValues.RemoveAt(index);
                lstRequests.Items.RemoveAt(index);
                ValidateForm();
            }
        }

        // בדיקה האם לאפשר את כפתור ההפעלה
        private void ValidateForm()
        {
            btnExtract.Enabled = (cmbFiles.SelectedIndex != -1 &&
                                  searchValues.Count > 0 &&
                                  !string.IsNullOrEmpty(txtOutputFolderInput.Text.Trim()));

            if (btnExtract.Enabled)
            {
                btnExtract.BackColor = colorSuccess;
                btnExtract.Cursor = Cursors.Hand;
            }
            else
            {
                btnExtract.BackColor = Color.FromArgb(189, 195, 199);
                btnExtract.Cursor = Cursors.No;
            }
        }

        // אירוע סריקת הקובץ וכתיבה לנתיב השמירה שנבחר ידנית במחשב
        private void BtnExtract_Click(object sender, EventArgs e)
        {
            try
            {
                if (cmbFiles.SelectedIndex == -1) return;

                string selectedFileName = cmbFiles.SelectedItem.ToString();
                string sourcePath = Path.Combine(targetFolder, selectedFileName);

                if (!File.Exists(sourcePath))
                {
                    MessageBox.Show("קובץ המקור לא נמצא פיזית בדיסק!", "שגיאה", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                string outputFolder = txtOutputFolderInput.Text.Trim();
                if (!Directory.Exists(outputFolder))
                {
                    MessageBox.Show("נתיב השמירה שבחרת לא קיים במחשב!", "שגיאה", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                string outputPath = Path.Combine(outputFolder, "search_results_notepad.txt");
                int matchCount = 0;

                btnExtract.Enabled = false;
                btnScan.Enabled = false;
                btnBrowseOutput.Enabled = false;
                btnAdd.Enabled = false;
                btnRemove.Enabled = false;

                Encoding hebrewEncoding = Encoding.GetEncoding(1255);

                long totalBytes = new FileInfo(sourcePath).Length;
                long bytesRead = 0;

                using (var reader = new StreamReader(sourcePath, hebrewEncoding))
                using (var writer = new StreamWriter(outputPath, false, hebrewEncoding))
                {
                    string line;
                    int lineNo = 0;
                    int updateCounter = 0;

                    while ((line = reader.ReadLine()) != null)
                    {
                        lineNo++;
                        updateCounter++;

                        bytesRead += hebrewEncoding.GetByteCount(line) + 2;

                        if (string.IsNullOrWhiteSpace(line)) continue;

                        bool isMatch = false;
                        foreach (string val in searchValues)
                        {
                            if (line.IndexOf(val, StringComparison.OrdinalIgnoreCase) >= 0)
                            {
                                isMatch = true;
                                break;
                            }
                        }

                        if (!isMatch)
                        {
                            char[] cleanChars = new char[line.Length];
                            int charCount = 0;
                            for (int i = 0; i < line.Length; i++)
                            {
                                if (line[i] >= '0' && line[i] <= '9')
                                {
                                    cleanChars[charCount++] = line[i];
                                }
                            }
                            string cleanLine = new string(cleanChars, 0, charCount);

                            foreach (string val in searchValues)
                            {
                                if (cleanLine.Contains(val))
                                {
                                    isMatch = true;
                                    break;
                                }
                            }
                        }

                        if (isMatch)
                        {
                            writer.WriteLine(line);
                            matchCount++;
                        }

                        if (updateCounter >= 5000)
                        {
                            updateCounter = 0;
                            int progressPercent = (int)((bytesRead * 100) / totalBytes);
                            if (progressPercent > 100) progressPercent = 100;

                            prgStatus.Value = progressPercent;
                            lblProgressText.Text = $"סורק שורה {lineNo:N0}... ({progressPercent}%) | נמצאו: {matchCount}";

                            Application.DoEvents();
                        }
                    }

                    prgStatus.Value = 100;
                    lblProgressText.Text = $"הסתיים בהצלחה! חולצו {matchCount} שורות.";
                }

                MessageBox.Show($"🎉 החילוץ לפנקס רשימות הסתיים בהצלחה!\n\nנמצאו וחולצו {matchCount} שורות מלאות.\nהקובץ החדש מחכה לך בנתיב המבוקש:\n{outputPath}", "הצלחה - NM Software", MessageBoxButtons.OK, MessageBoxIcon.Information);

                btnExtract.Enabled = true;
                btnScan.Enabled = true;
                btnBrowseOutput.Enabled = true;
                btnAdd.Enabled = true;
                btnRemove.Enabled = true;
                ValidateForm();
            }
            catch (Exception ex)
            {
                MessageBox.Show("שגיאה במהלך סריקת הקובץ:\n" + ex.Message, "שגיאה חמורה", MessageBoxButtons.OK, MessageBoxIcon.Error);
                btnExtract.Enabled = true;
                btnScan.Enabled = true;
                btnBrowseOutput.Enabled = true;
                btnAdd.Enabled = true;
                btnRemove.Enabled = true;
                ValidateForm();
            }
        }
