javascript:(async()=>{let c={};(await navigator.clipboard.readText()).split(',').map(x=>{let[d,i,o]=x.split(' '),y=document.querySelector('[fieldname=day][value="'+d+'"]');if(!y||(c[d]=-~c[d])>4)return;if(c[d]<2){let s=document.getElementById('fstjid_'+y.id.slice(4));s.selectedIndex=1;s.dispatchEvent(new Event('change'))}[['start',i],['end',o]].map(([a,t])=>t.split(':').map((v,j)=>{let e=document.getElementsByName(`time_${a}_${c[d]}_${j?'MM':'HH'}_${y.id.slice(4)}`)[0];e.value=v;e.dispatchEvent(new Event('change'))}))})})()
