  timeBoxArray[2][i]=	append_element_by_name('time_end_'+i+'_HH_',rowNo);
  timeBoxArray[3][i]=	append_element_by_name('time_end_'+i+'_MM_',rowNo);
};
if (atype==92) {
  showElm(unitBox);
  for (i=0;i<=4;i++) {
   for (j=0;j<4;j++)
     hideElm(timeBoxArray[j][i]);
  //hideElm(timeBoxArray[0][i].parentNode);
  //hideElm(timeBoxArray[2][i].parentNode);
  };
} else {
  hideElm(unitBox);
  for (i=0;i<=4;i++) {
    for (j=0;j<4;j++)
      showElm(timeBoxArray[j][i]);

  //showElm(timeBoxArray[0][i].parentNode);
