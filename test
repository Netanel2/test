     elm.style.visibility='hidden';
     }
}
function showElm(elm)  {
    if (elm)
     elm.style.visibility='visible';
}

function update_time_pick(elm) {
var timeBoxArray = new Array(new Array(),new Array(),new Array(),new Array());
//atype=elm[elm.selectedIndex].atype;
