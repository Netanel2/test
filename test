        private void btnScan_Click(object sender, EventArgs e)
        {
            RefreshFiles();
        }
        private void RefreshFiles()
        {
            try
            {
                cmbFiles.Items.Clear();
                targetFolder = txtFolderInput.Text.Trim();

                if (Directory.Exists(targetFolder))
                {
                    string[] files = Directory.GetFiles(targetFolder, "*");
                    foreach (string file in files) cmbFiles.Items.Add(Path.GetFileName(file));
                    if (cmbFiles.Items.Count > 0) { cmbFiles.SelectedIndex = 0; cmbFiles.Visible = true; }
                }
            }
            catch { }
            ValidateForm();
        }

        private void ValidateForm()
        {
            bool isValid = (cmbFiles.SelectedIndex != -1 && 
                            searchValues.Count > 0 && 
                            !string.IsNullOrEmpty(txtOutputFolderInput.Text.Trim()));

            btnExtract.Enabled = isValid;

            if (isValid)
            {
                btnExtract.BackColor = colorPrimary;
                btnExtract.ForeColor = Color.White;
                ShowToast("🟢 המערכת מוכנה להפעלת החילוץ", colorSuccess, Color.White);
            }
            else
            {
                btnExtract.BackColor = Color.FromArgb(229, 231, 235);
                btnExtract.ForeColor = Color.FromArgb(156, 163, 175);
                ShowToast("🟡 Waiting for input", Color.FromArgb(254, 243, 199), Color.FromArgb(180, 83, 9));
            }
        }

        private void ShowToast(string message, Color bg, Color fg)
        {
            pnlAlert.BackColor = bg;
            lblAlertText.Text = message;
            lblAlertText.ForeColor = fg;
            pnlAlert.Invalidate();
        }

        // --- לוגיקת סריקת הסטרימינג המהירה של NM SOFTWARE ---
        private void BtnExtract_Click(object sender, EventArgs e)
        {
            try
            {
                if (cmbFiles.SelectedIndex == -1) return;

                string selectedFileName = cmbFiles.SelectedItem.ToString();
                string sourcePath = Path.Combine(targetFolder, selectedFileName);

                if (!File.Exists(sourcePath)) return;

                string outputFolder = txtOutputFolderInput.Text.Trim();
                if (!Directory.Exists(outputFolder)) return;

                string outputPath = Path.Combine(outputFolder, "search_results_notepad.txt");
                int matchCount = 0;

                // הפעלת רכיבי ה-Progress המעוצבים
                lblProgressText.Visible = true;
                lblProgressPercent.Visible = true;
                pnlCustomProgress.Visible = true;
                ShowToast("🟢 Processing...", colorSuccess, Color.White);

                Encoding hebrewEncoding = Encoding.GetEncoding(1255);
                long totalBytes = new FileInfo(sourcePath).Length;
                long bytesRead = 0;

                using (var reader = new StreamReader(sourcePath, hebrewEncoding))
                using (var writer = new StreamWriter(outputPath, false, hebrewEncoding))
                {
                    string line;
                    int lineNo = 0;
                    int updateCounter = 0;

                    while ((line = reader.ReadLine()) != null)
                    {
                        lineNo++;
                        updateCounter++;
                        bytesRead += hebrewEncoding.GetByteCount(line) + 2;

                        if (string.IsNullOrWhiteSpace(line)) continue;

                        bool isMatch = false;
                        foreach (string val in searchValues)
                        {
                            if (line.IndexOf(val, StringComparison.OrdinalIgnoreCase) >= 0)
                            {
                                isMatch = true;
                                break;
                            }
                        }

                        if (!isMatch)
                        {
                            char[] cleanChars = new char[line.Length];
                            int charCount = 0;
                            for (int i = 0; i < line.Length; i++)
                            {
                                if (line[i] >= '0' && line[i] <= '9') cleanChars[charCount++] = line[i];
                            }
                            string cleanLine = new string(cleanChars, 0, charCount);

                            foreach (string val in searchValues)
                            {
                                if (cleanLine.Contains(val))
                                {
                                    isMatch = true;
                                    break;
                                }
                            }
                        }

                        if (isMatch)
                        {
                            writer.WriteLine(line);
                            matchCount++;
                        }

                        if (updateCounter >= 5000)
                        {
                            updateCounter = 0;
                            progressValue = (int)((bytesRead * 100) / totalBytes);
                            if (progressValue > 100) progressValue = 100;

                            lblProgressPercent.Text = $"{progressValue}%";
                            lblProgressText.Text = $"סורק שורה {lineNo:N0}... | נמצאו: {matchCount}";
                            
                            pnlCustomProgress.Invalidate(); // ציור מחדש של הגרדיאנט
                            Application.DoEvents(); 
                        }
                    }

                    progressValue = 100;
                    pnlCustomProgress.Invalidate();
                }

                ShowToast($"🟢 Extraction completed successfully | חולצו {matchCount} שורות", colorSuccess, Color.White);
                MessageBox.Show($"🎉 החילוץ לפנקס רשימות הסתיים בהצלחה!\n\nהקובץ החדש מחכה לך בנתיב המבוקש:\n{outputPath}", "Success - NM Software", MessageBoxButtons.OK, MessageBoxIcon.Information);
                
                btnExtract.Enabled = true;
                btnScan.Enabled = true;
                btnBrowseOutput.Enabled = true;
                btnAdd.Enabled = true;
                ValidateForm();
            }
            catch (Exception ex)
            {
                ShowToast("🔴 שגיאה חמורה במהלך סריקת הקובץ", colorDanger, Color.White);
                MessageBox.Show("שגיאה:\n" + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                
                btnExtract.Enabled = true;
                btnScan.Enabled = true;
                btnBrowseOutput.Enabled = true;
                btnAdd.Enabled = true;
                ValidateForm();
            }
        }
