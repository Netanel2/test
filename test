        private void BtnAdd_Click()
        {
            string rawVal = txtSearchValue.Text.Trim();
            string cleanVal = Regex.Replace(rawVal, @"[^\d]", "");

            if (string.IsNullOrEmpty(cleanVal))
            {
                ShowToast("🔴 אנא הזן מספר פלאפון תקין המכיל ספרות בלבד", colorDanger, Color.White);
                return;
            }

            if (searchValues.Contains(cleanVal))
            {
                ShowToast("🟡 המספר הזה כבר קיים ברשימת החיפוש שלך", colorWarning, Color.FromArgb(180, 83, 9));
                return;
            }

            searchValues.Add(cleanVal);
            CreateChip(rawVal, cleanVal);

            txtSearchValue.Text = "";
            txtSearchValue.Focus();
            ValidateForm();
        }

        private void CreateChip(string displayText, string cleanValue)
        {
            // יצירת פאנל תגית (Chip) מעוגל בסגנון Windows 11 Fluent
            Panel chip = new Panel() { Size = new Size(150, 32), BackColor = Color.FromArgb(243, 244, 246), Margin = new Padding(4) };
            chip.Paint += (s, e) =>
            {
                e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
                using (GraphicsPath path = new GraphicsPath())
                {
                    int r = 12;
                    path.AddArc(0, 0, r, r, 180, 90);
                    path.AddArc(chip.Width - r, 0, r, r, 270, 90);
                    path.AddArc(chip.Width - r, chip.Height - r, r, r, 0, 90);
                    path.AddArc(0, chip.Height - r, r, r, 90, 90);
                    path.CloseAllFigures();
                    chip.Region = new Region(path);
                }
            };

            Label lblText = new Label() { Text = displayText, Location = new Point(30, 6), Size = new Size(115, 20), Font = fontBold, ForeColor = colorTextDark, TextAlign = ContentAlignment.TopRight };
            
            // כפתור ה-X המודרני למחיקה מהירה בלחיצה
            Label lblClose = new Label() { Text = "×", Location = new Point(5, 4), Size = new Size(20, 22), Font = fontSection, ForeColor = colorTextMuted, Cursor = Cursors.Hand, TextAlign = ContentAlignment.TopCenter };
            lblClose.MouseEnter += (s, e) => lblClose.ForeColor = colorDanger;
            lblClose.MouseLeave += (s, e) => lblClose.ForeColor = colorTextMuted;
            lblClose.Click += (s, e) =>
            {
                searchValues.Remove(cleanValue);
                pnlChips.Controls.Remove(chip);
                ValidateForm();
            };

            chip.Controls.AddRange(new Control[] { lblText, lblClose });
            pnlChips.Controls.Add(chip);
        }

