קוד 1: העתקה (באתר הדיווח הראשון)

שמרו כסימנייה והדביקו בשדה הכתובת (URL):

javascript:(()=>{let o=[];document.querySelectorAll('[id$=uxEditingInTime]').forEach(i=>{let b=i.id.replace('EditingInTime',''),e=document.getElementById(b+'EditingOutTime').value;i.value&&e&&o.push(document.getElementById(b+'ReferenceDate').value.slice(0,10).split('/').reverse().join('-')+' '+i.value+' '+e)});navigator.clipboard.writeText(o.join());alert(o.length)})()

בלחיצה תופיע הודעה עם מספר הימים שהועתקו.

קוד 2: הדבקה (באתר השני)
javascript:(async()=>{let t=await navigator.clipboard.readText(),n=0;t.split(',').forEach(x=>{let[d,i,o]=x.split(' '),y=document.querySelector('[fieldname=day][value="'+d+'"]');if(!y)return;let k=y.id.split('_')[1],s=(a,v)=>{let e=document.getElementsByName(a+k)[0];e.value=v;e.dispatchEvent(new Event('change'))};s('time_start_1_HH_',i.slice(0,2));s('time_start_1_MM_',i.slice(3));s('time_end_1_HH_',o.slice(0,2));s('time_end_1_MM_',o.slice(3));n++});alert(n)})()
