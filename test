using System;
using System.Diagnostics;
using Microsoft.SqlServer.Dts.Runtime;

public void Main()
{
    try
    {
        string query = Uri.EscapeDataString("גלידה");
        Process.Start(new ProcessStartInfo
        {
            FileName = "https://www.google.com/search?q=" + query,
            UseShellExecute = true
        });

        Dts.TaskResult = (int)ScriptResults.Success;
    }
    catch (Exception ex)
    {
        Dts.Events.FireError(0, "GlidaSearch", ex.Message, "", 0);
        Dts.TaskResult = (int)ScriptResults.Failure;
    }
}
השלבים:

גרור Script Task ל-Control Flow
לחיצה כפולה → Edit Script (זה יפתח VSTA)
החלף את Main() בקוד למעלה
שמור, סגור, הרץ (F5 או Execute Task)

אבל חשוב שתדע מגבלה מהותית: זה יעבוד רק כשאתה מריץ את החבילה אינטראקטיבית מ-Visual Studio/SSDT על המחשב שלך. אם החבילה תרוץ מ-SQL Agent או מהקטלוג על השרת — היא רצה תחת חשבון שירות בלי session גרפי, אז הדפדפן לא ייפתח (או ייפתח על השרת בלי שאף אחד יראה אותו). בסביבה כמו שלך זה כנראה גם ייחסם על ידי מדיניות.
אז זה מגניב כניסוי/בדיקה מקומית, אבל אם יש מאחורי זה צורך אמיתי — למשל למשוך תוצאות חיפוש לתוך טבלה — הכיוון הנכון ב-SSIS זה HttpWebRequest/WebClient בתוך ה-Script Task (או Web Service Task) ולא פתיחת דפדפן. מה אתה בעצם מנסה להשיג עם זה?
