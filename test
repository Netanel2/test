        private void ExtractionForm_DragDrop(object sender, DragEventArgs e)
        {
            string[] files = (string[])e.Data.GetData(DataFormats.FileDrop);
            if (files.Length > 0)
            {
                string path = files[0];
                if (Directory.Exists(path))
                {
                    txtFolderInput.Text = path;
                    RefreshFiles();
                    ShowToast("🟡 התיקייה נגררה ועודכנה במערכת", colorWarning, Color.FromArgb(180, 83, 9));
                }
                else if (File.Exists(path))
                {
                    txtFolderInput.Text = Path.GetDirectoryName(path);
                    RefreshFiles();
                    cmbFiles.SelectedItem = Path.GetFileName(path);
                    ShowToast("🟡 קובץ המקור נגרר והתקבל בהצלחה", colorWarning, Color.FromArgb(180, 83, 9));
                }
            }
        }

