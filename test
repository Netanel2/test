use msdb
if OBJECT_ID('tempdb..#tb_sysjobschedules_PSRS')is not null
       drop table #tb_sysjobschedules_PSRS

select  
distinct
	sysschedules.date_modified as 'date_modified'
	,sysjobs.name job_name
	,case when sysjobs.enabled=1 then 'enabled' 
		else 'not_enabled'  end as 'job_enabled'
	,case when sysschedules.enabled=1 then 'enabled' 
		else 'not_enabled'  end as 'schedule_enabled'
	,sysschedules.name schedule_name,
	LEFT (left (RIGHT('0'+CAST( sysjobschedules.next_run_time AS  VARCHAR(6)),6),4),2)++':'+
	right (left (RIGHT('0'+CAST( sysjobschedules.next_run_time AS  VARCHAR(6)),6),4),2) as 'next_run_time' ,
	left (sysjobschedules.next_run_date,4)+'-'+ right ((left (sysjobschedules.next_run_date,6)),2)+'-'+ right (sysjobschedules.next_run_date,2) as 'next_run_date'
	
	into #tb_sysjobschedules_PSRS
	from msdb.dbo.sysjobs
 
	inner join msdb.dbo.sysjobschedules on sysjobs.job_id = sysjobschedules.job_id
	inner join msdb.dbo.sysschedules on sysjobschedules.schedule_id = sysschedules.schedule_id
	where  
	sysschedules.date_modified >= CONVERT(char(10),GetDate(),126) 
	order by sysjobs.name asc,sysschedules.date_modified desc

