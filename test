<script>
function setSecComboVals(elm) {
theComboName=elm.id.substr(3,999);
theComboFieldName=elm.getAttribute('fieldName');


theCombo=document.createElement('SELECT');
theCombo.setAttribute('id',theComboName);
theCombo.setAttribute('name',theComboName);
theCombo.setAttribute('fieldName',theComboFieldName);
theCombo.setAttribute('style','font-size:13px');

secs=elm[elm.selectedIndex].getAttribute('lids').split(',');

if (secs.length>0) {
  for (i=0;i<secs.length;i=i+2) {
    optElm=document.createElement('OPTION');
    optElm.value=secs[i];
     optElm.text=secs[i+1];
     optElm.innerText=secs[i+1];
   theCombo.appendChild(optElm);
  }
}
if (theCombo.firstChild.innerText=='' ||theCombo.firstChild.innerText=='undefined' ) {
    theCombo.style.visibility='hidden';
};

oldElm=eval('elm.form.'+theComboName);

oldElm.parentNode.replaceChild(theCombo,oldElm);
sortSelect(theCombo,0);
return theCombo;
}

function filterSecCombo(elm) {
	secCombo=setSecComboVals(elm);
