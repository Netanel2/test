שלב 2: קוד להעתקה (באתר הדיווח הראשון)

פתחו את הדף עם טבלת השעות והריצו:

(async()=>{const out=[];document.querySelectorAll('tr[id$="uxMainDivuhItemsTR"]').forEach(r=>{const g=s=>r.querySelector('[id$="'+s+'"]');const d=g('uxReferenceDate'),i=g('uxEditingInTime'),o=g('uxEditingOutTime');if(!d||!i||!o||!i.value||!o.value)return;const[dd,mm,yy]=d.value.split(' ')[0].split('/');out.push({date:yy+'-'+mm+'-'+dd,in:i.value,out:o.value});});const t=JSON.stringify(out);try{await navigator.clipboard.writeText(t);alert('הועתקו '+out.length+' ימים')}catch(e){prompt('העתיקו את הטקסט (Ctrl+C):',t)}})();

תופיע הודעה עם מספר הימים שהועתקו. אם הדפדפן לא מאפשר העתקה אוטומטית, יקפוץ חלון עם טקסט, ואז פשוט מסמנים אותו ולוחצים Ctrl+C.

שלב 3: קוד להדבקה (באתר השני)

עברו ללשונית של דף השעות השני והריצו:

(async()=>{let t;try{t=await navigator.clipboard.readText()}catch(e){t=prompt('הדביקו כאן (Ctrl+V):')}const data=JSON.parse(t);let n=0;data.forEach(x=>{const day=document.querySelector('input[fieldname="day"][value="'+x.date+'"]');if(!day)return;const k=day.id.split('_')[1];const[ih,im]=x.in.split(':'),[oh,om]=x.out.split(':');const set=(nm,v)=>{const e=document.getElementsByName(nm)[0];if(e){e.value=v;e.dispatchEvent(new Event('change',{bubbles:true}))}};set('time_start_1_HH_'+k,ih);set('time_start_1_MM_'+k,im);set('time_end_1_HH_'+k,oh);set('time_end_1_MM_'+k,om);n++});alert('מולאו '+n+' ימים מתוך '+data.length)})();
