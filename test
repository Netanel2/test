        private void RunJavascript(string script)
        {
            string js = "javascript:" + script
                .Replace("\r", " ")
                .Replace("\n", " ")
                .Replace("\t", " ");

            SetClipboardTextSta(js);

            SendKeys.SendWait("%d");   // Alt + D
            Thread.Sleep(400);

            SendKeys.SendWait("^v");   // Ctrl + V
            Thread.Sleep(400);

            SendKeys.SendWait("{ENTER}");
            Thread.Sleep(1500);
        }

        private void SetClipboardTextSta(string text)
        {
            Exception error = null;

            Thread thread = new Thread(delegate ()
            {
                try
                {
                    Clipboard.SetText(text);
                }
                catch (Exception ex)
                {
                    error = ex;
                }
            });

            thread.SetApartmentState(ApartmentState.STA);
            thread.Start();
            thread.Join();

            if (error != null)
                throw error;
        }

        private IntPtr BringChromeToFront()
        {
            Process[] chromeProcesses = Process.GetProcessesByName("chrome");

            foreach (Process p in chromeProcesses)
            {
                if (p.MainWindowHandle != IntPtr.Zero && !string.IsNullOrEmpty(p.MainWindowTitle))
                {
                    IntPtr hWnd = p.MainWindowHandle;

                    if (IsIconic(hWnd))
                        ShowWindow(hWnd, SW_RESTORE);

                    SetForegroundWindow(hWnd);
                    Thread.Sleep(500);

                    return hWnd;
                }
            }

            throw new Exception("לא נמצא חלון Chrome פעיל.");
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
