using System;
using System.Diagnostics;
using System.Runtime.InteropServices;
using System.Threading;
using System.Windows.Forms;

namespace ST_ae33f964e57a479eadde530e793324bf
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        [DllImport("user32.dll")] static extern bool SetForegroundWindow(IntPtr hWnd);
        [DllImport("user32.dll")] static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
        [DllImport("user32.dll")] static extern bool IsIconic(IntPtr hWnd);
        [DllImport("user32.dll")] static extern bool GetWindowRect(IntPtr hWnd, out RECT lpRect);
        [DllImport("user32.dll")] static extern bool SetCursorPos(int X, int Y);
        [DllImport("user32.dll")] static extern void mouse_event(uint dwFlags, uint dx, uint dy, uint dwData, UIntPtr dwExtraInfo);

        const int SW_RESTORE = 9;
        const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
        const uint MOUSEEVENTF_LEFTUP = 0x0004;

        struct RECT
        {
            public int Left;
            public int Top;
            public int Right;
            public int Bottom;
        }

        public void Main()
        {
            try
            {
                string url = "https://iwaytest01/sapweb/ADM/Test-iWay01-CP/BIN/LISTENER.DLL?CTX=LOG!Test-iWay01-CP&X=Y";

                Process.Start(new ProcessStartInfo
                {
                    FileName = "chrome.exe",
                    Arguments = "--new-window \"" + url + "\"",
                    UseShellExecute = true
                });

                Thread.Sleep(5000);

                IntPtr chrome = BringChromeToFront();
                if (chrome == IntPtr.Zero)
                    throw new Exception("לא נמצא חלון Chrome פתוח.");

                SendKeys.SendWait("ALNETANM");
                Thread.Sleep(500);
                SendKeys.SendWait("{ENTER}");

                Thread.Sleep(12000);

                chrome = BringChromeToFront();
                Thread.Sleep(1000);

                // חיפוש הטקסט
                SendKeys.SendWait("^f");
                Thread.Sleep(800);
                SendKeys.SendWait("תשתיות");
                Thread.Sleep(1500);
                SendKeys.SendWait("{ESC}");
                Thread.Sleep(700);

                // ניסיון ראשון: לפתוח עם מקלדת
                SendKeys.SendWait("{ENTER}");
                Thread.Sleep(500);
                SendKeys.SendWait("{RIGHT}");
                Thread.Sleep(800);

                // ניסיון שני: קליק באזור הפלוס של העץ
                // כרום סימן את השורה שמצאנו. הפלוס בדרך כלל נמצא מעט שמאלה/ימינה מהטקסט לפי RTL/LTR.
                ClickTreePlusApprox(chrome);

                Thread.Sleep(500);
                SendKeys.SendWait("{RIGHT}");
                Thread.Sleep(500);
                SendKeys.SendWait("{ENTER}");

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "SAP_Automation_Error", ex.ToString(), "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        private IntPtr BringChromeToFront()
        {
            Process[] chromeProcesses = Process.GetProcessesByName("chrome");

            foreach (Process p in chromeProcesses)
            {
                if (p.MainWindowHandle != IntPtr.Zero && !string.IsNullOrEmpty(p.MainWindowTitle))
                {
                    IntPtr hWnd = p.MainWindowHandle;

                    if (IsIconic(hWnd))
                        ShowWindow(hWnd, SW_RESTORE);

                    SetForegroundWindow(hWnd);
                    Thread.Sleep(500);

                    return hWnd;
                }
            }

            return IntPtr.Zero;
        }

        private void ClickTreePlusApprox(IntPtr chromeWindow)
        {
            RECT rect;
            if (!GetWindowRect(chromeWindow, out rect))
                return;

            int width = rect.Right - rect.Left;
            int height = rect.Bottom - rect.Top;

            // התאמה כללית לעץ שמופיע בצד שמאל/אמצע.
            // אם זה מפספס — משנים רק את שני המספרים האלה.
            int x = rect.Left + 85;
            int y = rect.Top + (height / 2);

            SetCursorPos(x, y);
            Thread.Sleep(200);
            mouse_event(MOUSEEVENTF_LEFTDOWN, 0, 0, 0, UIntPtr.Zero);
            Thread.Sleep(80);
            mouse_event(MOUSEEVENTF_LEFTUP, 0, 0, 0, UIntPtr.Zero);
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
}
