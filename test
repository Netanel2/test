קוד 1: העתקה (באתר הראשון)
javascript:(()=>{let o=[],d;document.querySelectorAll('[id$=uxEditingInTime]').forEach(i=>{let b=i.id.slice(0,-13),r=document.getElementById(b+'ReferenceDate'),e=document.getElementById(b+'EditingOutTime').value;r&&(d=r.value.replace(/(..).(..).(....).*/,'$3-$2-$1'));i.value&&e&&o.push(d+' '+i.value+' '+e)});navigator.clipboard.writeText(o+'');alert(o.length)})()
קוד 2: הדבקה (באתר השני)
javascript:(async()=>{let c={};(await navigator.clipboard.readText()).split(',').map(x=>{let[d,i,o]=x.split(' '),y=document.querySelector('[fieldname=day][value="'+d+'"]');if(!y||(c[d]=-~c[d])>4)return;[['start',i],['end',o]].map(([a,t])=>t.split(':').map((v,j)=>{let e=document.getElementsByName(`time_${a}_${c[d]}_${j?'MM':'HH'}_${y.id.slice(4)}`)[0];e.value=v;e.dispatchEvent(new Event('change'))}))})})()
