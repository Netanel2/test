        // ---------- folder browse ----------
        private void BrowseFolder(TextBox target, bool scan)
        {
            using (var dlg = new FolderBrowserDialog())
            {
                if (Directory.Exists(target.Text)) dlg.SelectedPath = target.Text;
                if (dlg.ShowDialog() == DialogResult.OK)
                {
                    target.Text = dlg.SelectedPath;
                    if (scan) ScanFolder();
                }
            }
        }

        private void ScanFolder()
        {
            _files.Items.Clear();
            _targetFolder = _srcPath.Box.Text.Trim();
            if (Directory.Exists(_targetFolder))
            {
                foreach (var f in Directory.GetFiles(_targetFolder))
                    _files.Items.Add(Path.GetFileName(f));
                if (_files.Items.Count > 0) _files.SelectedIndex = 0;
            }
            Revalidate();
        }

        // ---------- phones / chips ----------
        private void AddPhone()
        {
            string raw = _phone.Box.Text.Trim();
            string clean = DigitsOnly(raw);
            if (clean.Length == 0) { SetStatus("Enter a valid phone number", Palette.Danger); return; }
            foreach (var p in _phones) if (p.Clean == clean) { SetStatus("That number is already in the list", Palette.Warning); return; }
            _phones.Add(new PhoneItem { Raw = raw, Clean = clean });
            _phone.Box.Clear(); _phone.Box.Focus();
            RefreshChips(); Revalidate();
        }

        private void RefreshChips()
        {
            _chips.Controls.Clear();
            foreach (var p in _phones)
            {
                var item = p;
                var chip = new Panel { Height = 30, BackColor = Palette.Chip, Margin = new Padding(0, 0, 8, 8) };
                var lbl = new Label { Text = item.Raw, ForeColor = Palette.ChipText, Font = new Font("Segoe UI", 9f, FontStyle.Bold),
                    AutoSize = true, Location = new Point(12, 6), BackColor = Palette.Chip };
                var close = new Label { Text = "x", ForeColor = Palette.ChipText, Font = new Font("Segoe UI", 9f, FontStyle.Bold),
                    AutoSize = true, Cursor = Cursors.Hand, BackColor = Palette.Chip };
                chip.Controls.Add(lbl);
                chip.Controls.Add(close);
                chip.Width = lbl.PreferredWidth + 44;
                close.Location = new Point(chip.Width - 22, 6);
                close.Click += (s, e) => { _phones.Remove(item); RefreshChips(); Revalidate(); };
                chip.Paint += (s, e) =>
                {
                    e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
                    using (var path = Draw.Round(new Rectangle(0, 0, chip.Width - 1, chip.Height - 1), 15))
                    using (var b = new SolidBrush(Palette.Chip))
                        e.Graphics.FillPath(b, path);
                };
                _chips.Controls.Add(chip);
            }
            _empty.Visible = _phones.Count == 0;
        }

        // ---------- validation / status ----------
        private void Revalidate()
        {
            bool ok = _files.SelectedIndex >= 0 && _phones.Count > 0 &&
                      !string.IsNullOrEmpty(_outPath.Box.Text.Trim());
            _start.Enabled = ok;
            if (ok) SetStatus("Ready to extract", Palette.Success);
            else SetStatus("Waiting for input - add a file and at least one number", Palette.Muted);
        }

        private void SetStatus(string text, Color color)
        {
            _status.Text = text;
            _status.ForeColor = (color == Palette.Muted) ? Palette.Text : color;
        }

        // ---------- extraction ----------
        private void StartExtraction()
        {
            string selected = _files.SelectedItem as string;
            if (selected == null) return;
            string sourcePath = Path.Combine(_targetFolder, selected);
            string outputFolder = _outPath.Box.Text.Trim();
            if (!File.Exists(sourcePath)) { SetStatus("Source file was not found on disk", Palette.Danger); return; }
            if (!Directory.Exists(outputFolder)) { SetStatus("Output folder does not exist", Palette.Danger); return; }

            string outputPath = Path.Combine(outputFolder, "search_results_notepad.txt");
            var terms = new List<PhoneItem>(_phones);

            _start.Enabled = false;
            _progLabel.Text = "Processing...";
            _bar.Value = 0;

            var worker = new BackgroundWorker { WorkerReportsProgress = true };
            worker.DoWork += (s, e) => e.Result = Extract(sourcePath, outputPath, terms, worker);
            worker.ProgressChanged += (s, e) =>
            {
                _bar.Value = e.ProgressPercentage;
                _progPct.Text = e.ProgressPercentage + "%";
            };
            worker.RunWorkerCompleted += (s, e) =>
            {
                if (e.Error != null)
                {
                    SetStatus("Extraction failed: " + e.Error.Message, Palette.Danger);
                }
                else
                {
                    _bar.Value = 100; _progPct.Text = "100%";
                    _progLabel.Text = "Completed";
                    int matches = (int)e.Result;
                    SetStatus("Extraction completed - " + matches.ToString("N0") + " rows saved", Palette.Success);
                }
                _start.Enabled = true;
            };
            worker.RunWorkerAsync();
        }

        private static int Extract(string sourcePath, string outputPath, List<PhoneItem> terms, BackgroundWorker worker)
        {
            Encoding enc = Encoding.GetEncoding(1255); // Hebrew - built in on the .NET Framework SSIS hosts
            long total = new FileInfo(sourcePath).Length;
            long bytesRead = 0;
            int matches = 0, tick = 0, lastPct = -1;

            using (var reader = new StreamReader(sourcePath, enc))
            using (var writer = new StreamWriter(outputPath, false, enc))
            {
                string line;
                while ((line = reader.ReadLine()) != null)
                {
                    tick++;
                    bytesRead += enc.GetByteCount(line) + 2;

                    if (!string.IsNullOrEmpty(line) && line.Trim().Length > 0 && IsMatch(line, terms))
                    {
                        writer.WriteLine(line);
                        matches++;
                    }

                    if (tick >= 5000)
                    {
                        tick = 0;
                        int pct = total > 0 ? (int)Math.Min(100, bytesRead * 100 / total) : 0;
                        if (pct != lastPct) { lastPct = pct; worker.ReportProgress(pct); }
                    }
                }
            }
            return matches;
        }

        private static bool IsMatch(string line, List<PhoneItem> terms)
        {
            foreach (var t in terms)
                if (line.IndexOf(t.Raw, StringComparison.OrdinalIgnoreCase) >= 0) return true;

            string digits = DigitsOnly(line);
            if (digits.Length > 0)
                foreach (var t in terms)
                    if (digits.Contains(t.Clean)) return true;

            return false;
        }

        private static string DigitsOnly(string s)
        {
            var sb = new StringBuilder(s.Length);
            foreach (char c in s) if (c >= '0' && c <= '9') sb.Append(c);
            return sb.ToString();
        }

        private class PhoneItem { public string Raw; public string Clean; }
    }
