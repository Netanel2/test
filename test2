                e.Graphics.FillPath(fill, path);
                e.Graphics.DrawPath(pen, path);
            }
            base.OnPaint(e);
        }
    }

    internal class GradientBar : Panel
    {
        private int _value;
        public int Value { get { return _value; } set { _value = Math.Max(0, Math.Min(100, value)); Invalidate(); } }
        public GradientBar() { DoubleBuffered = true; Height = 12; BackColor = Palette.Bg; }
        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            var full = new Rectangle(0, 0, Width - 1, Height - 1);
            using (var trackPath = Draw.Round(full, Height / 2))
            using (var track = new SolidBrush(Palette.Track))
                e.Graphics.FillPath(track, trackPath);

            int w = (int)((Width - 1) * (_value / 100.0));
            if (w > Height)
            {
                var fillRect = new Rectangle(0, 0, w, Height - 1);
                using (var fillPath = Draw.Round(fillRect, Height / 2))
                using (var grad = new LinearGradientBrush(fillRect, Palette.Success, Palette.Success2, 0f))
                    e.Graphics.FillPath(grad, fillPath);
            }
        }
    }

