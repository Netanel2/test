                    AutoSize = true, Cursor = Cursors.Hand, BackColor = Palette.Chip, Location = new Point(10, 6) };
                var lbl = new Label { Text = item.Raw, ForeColor = Palette.ChipText, Font = new Font("Segoe UI", 9f, FontStyle.Bold),
                    AutoSize = true, BackColor = Palette.Chip };
                chip.Controls.Add(close);
                chip.Controls.Add(lbl);
                chip.Width = lbl.PreferredWidth + 46;
                lbl.Location = new Point(30, 6);
                close.Click += (s, e) => { _phones.Remove(item); RefreshChips(); Revalidate(); };
