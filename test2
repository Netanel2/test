        // ---------- טעינת קבצים מהנתיב שהודבק ----------
        private void ScanFolder()
        {
            _files.Items.Clear();
            string folder = _srcPath.Box.Text.Trim().Trim('"');
            if (!Directory.Exists(folder))
            {
                SetStatus("התיקייה לא נמצאה - בדוק את הנתיב", Palette.Danger);
                Revalidate();
                return;
            }
            foreach (var f in Directory.GetFiles(folder))
                _files.Items.Add(Path.GetFileName(f));

            if (_files.Items.Count > 0)
            {
                _files.SelectedIndex = 0;
                SetStatus("נטענו " + _files.Items.Count + " קבצים - בחר קובץ", Palette.Success);
            }
            else
            {
                SetStatus("התיקייה ריקה", Palette.Warning);
            }
            Revalidate();
        }

