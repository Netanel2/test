        // ---------- חילוץ ----------
        private void StartExtraction()
        {
            string selected = _files.SelectedItem as string;
            if (selected == null) return;
            string folder = _srcPath.Box.Text.Trim().Trim('"');
            string sourcePath = Path.Combine(folder, selected);
            string outputFolder = _outPath.Box.Text.Trim();
            if (!File.Exists(sourcePath)) { SetStatus("קובץ המקור לא נמצא בדיסק", Palette.Danger); return; }
            if (!Directory.Exists(outputFolder)) { SetStatus("תיקיית היעד לא קיימת", Palette.Danger); return; }

            string outputPath = Path.Combine(outputFolder, "search_results_notepad.txt");
            var terms = new List<PhoneItem>(_phones);

            _start.Enabled = false;
            _progLabel.Text = "מעבד...";
            _bar.Value = 0;

            var worker = new BackgroundWorker { WorkerReportsProgress = true };
            worker.DoWork += (s, e) => e.Result = Extract(sourcePath, outputPath, terms, worker);
            worker.ProgressChanged += (s, e) =>
            {
                _bar.Value = e.ProgressPercentage;
                _progPct.Text = e.ProgressPercentage + "%";
            };
            worker.RunWorkerCompleted += (s, e) =>
            {
                if (e.Error != null)
                {
                    SetStatus("החילוץ נכשל: " + e.Error.Message, Palette.Danger);
                }
                else
                {
                    _bar.Value = 100; _progPct.Text = "100%";
                    _progLabel.Text = "הושלם";
                    int matches = (int)e.Result;
                    SetStatus("החילוץ הושלם - " + matches.ToString("N0") + " שורות נשמרו", Palette.Success);
                }
                _start.Enabled = true;
            };
            worker.RunWorkerAsync();
        }

        private static int Extract(string sourcePath, string outputPath, List<PhoneItem> terms, BackgroundWorker worker)
        {
            Encoding enc = Encoding.GetEncoding(1255); // עברית - מובנה ב-.NET Framework של SSIS
            long total = new FileInfo(sourcePath).Length;
            long bytesRead = 0;
            int matches = 0, tick = 0, lastPct = -1;

            using (var reader = new StreamReader(sourcePath, enc))
            using (var writer = new StreamWriter(outputPath, false, enc))
            {
                string line;
                while ((line = reader.ReadLine()) != null)
                {
                    tick++;
                    bytesRead += enc.GetByteCount(line) + 2;

                    if (!string.IsNullOrEmpty(line) && line.Trim().Length > 0 && IsMatch(line, terms))
                    {
                        writer.WriteLine(line);
                        matches++;
                    }

                    if (tick >= 5000)
                    {
                        tick = 0;
                        int pct = total > 0 ? (int)Math.Min(100, bytesRead * 100 / total) : 0;
                        if (pct != lastPct) { lastPct = pct; worker.ReportProgress(pct); }
                    }
                }
            }
            return matches;
        }

        private static bool IsMatch(string line, List<PhoneItem> terms)
        {
            foreach (var t in terms)
                if (line.IndexOf(t.Raw, StringComparison.OrdinalIgnoreCase) >= 0) return true;

            string digits = DigitsOnly(line);
            if (digits.Length > 0)
                foreach (var t in terms)
                    if (digits.Contains(t.Clean)) return true;

            return false;
        }

        private static string DigitsOnly(string s)
        {
            var sb = new StringBuilder(s.Length);
            foreach (char c in s) if (c >= '0' && c <= '9') sb.Append(c);
            return sb.ToString();
        }

        private class PhoneItem { public string Raw; public string Clean; }
    }
