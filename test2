        private void AddCardTitle(Card card, string title, string desc)
        {
            card.Controls.Add(new Label { Text = title, Font = new Font("Segoe UI", 11.5f, FontStyle.Bold),
                ForeColor = Palette.Text, AutoSize = true, Location = new Point(16, 14), BackColor = Palette.Card });
