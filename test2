// =====================================================================
//  NM Extractor Studio  —  interactive phone-number extractor
//  Hosted inside an SSIS Script Task (runs via dtexec, so no .exe is
//  deployed and AppLocker is not triggered).
//
//  This is the ORIGINAL interactive flow (browse folder -> pick file ->
//  add numbers -> Start), re-skinned as a modern flat WinForms UI.
//  Reads with Windows-1255 (Hebrew) and writes matching lines to
//  search_results_notepad.txt in the chosen output folder.
//
//  If System.Windows.Forms / System.Drawing are not already referenced
//  in the Script Task project, add them under Project -> References.
// =====================================================================

namespace ST_PhoneExtractor
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            try
            {
                System.Windows.Forms.Application.EnableVisualStyles();
                System.Windows.Forms.Application.SetCompatibleTextRenderingDefault(false);
                using (var form = new MainForm())
                {
                    form.ShowDialog();
                }
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "PhoneExtractor",
                    ex.Message + Environment.NewLine + ex.StackTrace, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }

