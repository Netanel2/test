    // =================================================================
    //  Rounded-shape helper
    // =================================================================
    internal static class Draw
    {
        public static GraphicsPath Round(Rectangle r, int radius)
        {
            int d = radius * 2;
            var p = new GraphicsPath();
            if (radius <= 0) { p.AddRectangle(r); p.CloseFigure(); return p; }
            p.AddArc(r.X, r.Y, d, d, 180, 90);
            p.AddArc(r.Right - d, r.Y, d, d, 270, 90);
            p.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90);
            p.AddArc(r.X, r.Bottom - d, d, d, 90, 90);
            p.CloseFigure();
            return p;
        }
    }

    // White rounded "card" panel with a light border.
    internal class Card : Panel
    {
        public int Radius = 12;
        public Card()
        {
            DoubleBuffered = true;
            BackColor = Palette.Bg;   // corners blend into the form
            Padding = new Padding(18);
        }
        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            var r = new Rectangle(0, 0, Width - 1, Height - 1);
            using (var path = Draw.Round(r, Radius))
            using (var fill = new SolidBrush(Palette.Card))
            using (var pen = new Pen(Palette.Border))
            {
                e.Graphics.FillPath(fill, path);
                e.Graphics.DrawPath(pen, path);
            }
            base.OnPaint(e);
        }
    }

    // Modern flat, rounded button.
    internal class FlatBtn : Button
    {
        public int Radius = 10;
        public Color Fill = Palette.Primary;
        public Color FillHover = Palette.PrimaryDk;
        private bool _hover;

        public FlatBtn()
        {
            FlatStyle = FlatStyle.Flat;
            FlatAppearance.BorderSize = 0;
            FlatAppearance.MouseOverBackColor = Color.Transparent;
            FlatAppearance.MouseDownBackColor = Color.Transparent;
            ForeColor = Color.White;
            BackColor = Palette.Bg;
            Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
            Cursor = Cursors.Hand;
            DoubleBuffered = true;
        }
        protected override void OnMouseEnter(EventArgs e) { _hover = true; Invalidate(); base.OnMouseEnter(e); }
        protected override void OnMouseLeave(EventArgs e) { _hover = false; Invalidate(); base.OnMouseLeave(e); }
        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            e.Graphics.Clear(Parent != null ? Parent.BackColor : Palette.Bg);
            var r = new Rectangle(0, 0, Width - 1, Height - 1);
            using (var path = Draw.Round(r, Radius))
            using (var fill = new SolidBrush(Enabled ? (_hover ? FillHover : Fill) : Palette.Border))
                e.Graphics.FillPath(fill, path);
            TextRenderer.DrawText(e.Graphics, Text, Font, r, Enabled ? ForeColor : Palette.Muted,
                TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
        }
    }

    // Rounded bordered wrapper hosting a borderless TextBox, with focus highlight.
    internal class InputBox : Panel
    {
        public TextBox Box = new TextBox();
        public InputBox()
        {
            DoubleBuffered = true;
            BackColor = Palette.Card;
            Height = 40;
            Box.BorderStyle = BorderStyle.None;
            Box.BackColor = Palette.Card;
            Box.ForeColor = Palette.Text;
            Box.Font = new Font("Segoe UI", 11f);
            Box.Dock = DockStyle.Fill;
            var host = new Panel { Dock = DockStyle.Fill, BackColor = Palette.Card, Padding = new Padding(12, 9, 12, 0) };
            host.Controls.Add(Box);
            Controls.Add(host);
            Box.GotFocus += (s, e) => Invalidate();
            Box.LostFocus += (s, e) => Invalidate();
        }
        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            var r = new Rectangle(0, 0, Width - 1, Height - 1);
            using (var path = Draw.Round(r, 8))
            using (var fill = new SolidBrush(Palette.Card))
            using (var pen = new Pen(Box.Focused ? Palette.Primary : Palette.Border, Box.Focused ? 2 : 1))
            {
                e.Graphics.FillPath(fill, path);
                e.Graphics.DrawPath(pen, path);
            }
            base.OnPaint(e);
        }
    }

    // Custom gradient progress bar.
    internal class GradientBar : Panel
    {
        private int _value;
        public int Value { get { return _value; } set { _value = Math.Max(0, Math.Min(100, value)); Invalidate(); } }
        public GradientBar() { DoubleBuffered = true; Height = 12; BackColor = Palette.Bg; }
        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            var full = new Rectangle(0, 0, Width - 1, Height - 1);
            using (var trackPath = Draw.Round(full, Height / 2))
            using (var track = new SolidBrush(Palette.Track))
                e.Graphics.FillPath(track, trackPath);

            int w = (int)((Width - 1) * (_value / 100.0));
            if (w > Height)
            {
                var fillRect = new Rectangle(0, 0, w, Height - 1);
                using (var fillPath = Draw.Round(fillRect, Height / 2))
                using (var grad = new LinearGradientBrush(fillRect, Palette.Success, Palette.Success2, 0f))
                    e.Graphics.FillPath(grad, fillPath);
            }
        }
    }

