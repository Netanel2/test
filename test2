        // ---------- מספרים / chips ----------
        private void AddPhone()
        {
            string raw = _phone.Box.Text.Trim();
            string clean = DigitsOnly(raw);
            if (clean.Length == 0) { SetStatus("הכנס מספר טלפון תקין", Palette.Danger); return; }
            foreach (var p in _phones) if (p.Clean == clean) { SetStatus("המספר כבר קיים ברשימה", Palette.Warning); return; }
            _phones.Add(new PhoneItem { Raw = raw, Clean = clean });
            _phone.Box.Clear(); _phone.Box.Focus();
            RefreshChips(); Revalidate();
        }

